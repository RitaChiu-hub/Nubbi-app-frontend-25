{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://stthomas.beta.instructure.com"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://stthomas.beta.instructure.com https://canvas.beta.instructure.com"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],

  "rewrites": [{ "source": "/:path*", "destination": "/" }]
}
