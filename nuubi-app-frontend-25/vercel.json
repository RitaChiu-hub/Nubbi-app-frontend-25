{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.instructure.com https://*.ondigitalocean.app"
        }
      ]
    }
  ],

  "rewrites": [
    { "source": "/lti-login(/.*)?", "destination": "/" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
