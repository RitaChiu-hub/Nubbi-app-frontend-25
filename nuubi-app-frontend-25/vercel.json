{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "ALLOW-FROM https://stthomas.beta.instructure.com",
        "Content-Security-Policy": "frame-ancestors 'self' https://*.instructure.com"
      }
    },
    { "handle": "filesystem" },
    { "src": "/lti-login/?$", "dest": "/" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
