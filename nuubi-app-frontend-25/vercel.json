{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": " "
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://stthomas.beta.instructure.com https://canvas.beta.instructure.com;"
        }
      ]
    }
  ],

  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [{ "source": "/:path*", "destination": "/" }]
}
