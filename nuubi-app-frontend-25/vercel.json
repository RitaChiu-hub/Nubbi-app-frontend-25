{
  "cleanUrls": true,

  "rewrites": [
    { "source": "/lti-login(/.*)?", "destination": "/" },
    { "source": "/(.*)", "destination": "/" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://stthomas.beta.instructure.com"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.instructure.com"
        }
      ]
    }
  ]
}
