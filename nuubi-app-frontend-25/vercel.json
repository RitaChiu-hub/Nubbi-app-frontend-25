{
  "routes": [
    {
      "src": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://stthomas.beta.instructure.com"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.instructure.com"
        }
      ]
    },
    { "handle": "filesystem" },

    { "src": "/lti-login/?$", "dest": "/" },

    { "src": "/(.*)", "dest": "/" }
  ]
}
